import java.util.*;
public class Main {
    private static long powInt(int base, int exp) {
        long result = 1;
        for (int i = 0; i < exp; i++) result *= base;
        return result;
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNextLong()) return;
        long n = sc.nextLong();
        if (n < 0) {
            System.out.print("Not Armstrong");
            return;
        }
        long temp = n;
        int digits = 0;
        if (temp == 0) digits = 1;
        while (temp > 0) {
            digits++;
            temp /= 10;
        }
        temp = n;
        long sum = 0;
        while (temp > 0) {
            int digit = (int)(temp % 10);
            sum += powInt(digit, digits);
            temp /= 10;
        }
       if (n == 0) sum = 0;
        if (sum == n) System.out.print("Armstrong");
        else System.out.print("Not Armstrong");
    }
}
