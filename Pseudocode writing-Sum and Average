import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
    int sum = 0;
    int[] nums = new int[5];
    for (int i = 0; i < 5; i++) {
        nums[i] = sc.nextInt();
        sum += nums[i];
    }
    double average = sum / 5.0;
    System.out.println("Sum = " + sum);
    System.out.println("Average = " + average);
}
}
